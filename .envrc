# Usage: TSFM_ENV=main|legacy; source .envrc
export TSFM_ENV=${TSFM_ENV:-main}
export UV_PROJECT_ENVIRONMENT=/raid/f.decastelli/venvs/tsfm-zoo-$TSFM_ENV
export UV_CACHE_DIR=/raid/f.decastelli/uv_cache
export TSFM_ZOO_CACHE=/raid/f.decastelli/tsfm-zoo-cache
export HF_HOME=/raid/f.decastelli/tsfm-zoo-cache/hf
export GIFT_EVAL=/raid/f.decastelli/tsfm-zoo-cache/gift-eval
# The env's own tools (ninja) on PATH; CUDA 12.x toolkit for TiRex-2's JIT kernels (torch is cu128; the system default nvcc is 13).
export PATH=$UV_PROJECT_ENVIRONMENT/bin:$PATH
export CUDA_HOME=$TSFM_ZOO_CACHE/cuda-12.8   # scripts/setup_cuda.sh
export TORCH_EXTENSIONS_DIR=$TSFM_ZOO_CACHE/torch_extensions
# tgdata: the PeMS datasets already downloaded on this machine (found offline); HF_HOME above hides the default HF token.
export TGDATA_ROOT=/raid/f.decastelli/tgdata_build/_hubcache2
export HF_TOKEN_PATH=$HOME/.cache/huggingface/token
export TSFM_EMBEDDINGS=$TSFM_ZOO_CACHE/embeddings
